				  <td width=238><p><font size="-2"><span class="flieklein"><b>Hinweise:</b></span></font></p>
                    <p><font size="-2"><span class="flieklein">DWdW    =&nbsp;Das Wesen des Wassers</span></font><font size="-2"><span class="flieklein">.</span></font><br>
                      <font size="-2"><span class="flieklein">Impl.: = Zeitschrift Implosion</span></font><br>
                      <font size="-2"><span class="flieklein">CD-ROM  = Wasser - Das Blut der Erde</span></font></p>
<p><font size="-1"><span class="flie">Schauberger-Archiv, 2005</span></font></p></td>
					<td width=42 height=1></td>
				</tr>
