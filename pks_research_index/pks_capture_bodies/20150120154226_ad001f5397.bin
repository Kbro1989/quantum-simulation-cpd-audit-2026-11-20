          </span></font><a href="Resources/PAT_196_680_esp.pdf" target="_blank">SP 203 765</a><font size="-1"><span class="flie"> </span></font></p></td>
      <td width=79 valign=top><p><font size="-1"><span class="flie">30.05.1951</span></font></p>
