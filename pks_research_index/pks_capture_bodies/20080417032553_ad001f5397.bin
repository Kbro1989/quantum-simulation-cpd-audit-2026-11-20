								</td>
							</tr>
							<tr><td height=20 width=105 valign=middle><p><font size="-1">(i. A. &Ouml;sterr.)<br>
										</font></p>
									<p><font size="-1">D.R.P.A. = Deutsches Reichspatentamt<br>
										</font></p>
								</td><td width=105 valign=middle><p></p></td>
								<td width=82 valign=middle><p></p></td>
								<td width=234 valign=middle></td>
								<td width=130 valign=middle><p></p></td>
							</tr><tr><td height=20 width=105 valign=top><img src="Resources/_clear.gif" border=0 width=1 height=1 alt=""></td><td width=105 valign=top><img src="Resources/_clear.gif" border=0 width=1 height=1 alt=""></td>
								<td width=82 valign=top><img src="Resources/_clear.gif" border=0 width=1 height=1 alt=""></td>
								<td width=234 valign=top></td>
								<td width=130 valign=top><img src="Resources/_clear.gif" border=0 width=1 height=1 alt=""></td>
							</tr><tr><td height=38 width=105 valign=top><p><font size="-1"><span class="flie">113 526 </span></font></p><p><font size="-1"><span class="flie">&nbsp;</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">20.11.1925</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">15.12.1926 </span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Vorrichtung zum Heranziehen und &Uuml;berf&uuml;hren von Holzsortimenten aus Fangstauen in die Schwemmstra&szlig;e </span></font></p>
								</td>
								<td width=130 valign=top><p></p></td>
							</tr><tr><td height=37 width=105 valign=top><p><font size="-1"><span class="flie">113 848 </span></font></p><p><font size="-2"><span class="flieklein">auch:<br></span></font><font size="-2"><span class="flieklein">DE 573 856</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">19.08.1926</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">15.02.1929</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Verfahren und Vorrichtung, um beim Schwemmen verschiedene Holzsortimente voneinander zu trennen</span></font></p>
								</td>
								<td width=130 valign=top><p></p></td>
							</tr><tr><td height=20 width=105 valign=top><p><font size="-1"><span class="flie">117 749</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">21.12.1926</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">15.01.1930</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Strahlturbine </span></font></p>
								</td>
								<td width=130 valign=top><p><font size="-2"><span class="flieklein">Impl. Nr. 58</span></font></p></td>
							</tr><tr><td height=30 width=105 valign=top><p><font size="-1"><span class="flie">113 487</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">31.01.1927</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">15.01.1929</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Einbau zur Wildbachverbauung und Flussregulierung </span></font></p>
								</td>
								<td width=130 valign=top><p><font size="-2"><span class="flieklein">Impl. Nr. 16<br>
												CD-ROM</span></font></p></td>
							</tr><tr><td height=48 width=105 valign=top><p><font size="-1"><span class="flie">113 772 </span></font></p><p><font size="-2"><span class="flieklein">auch:<br></span></font><font size="-2"><span class="flieklein">USA 1,775,871</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">23.07.1928</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">15.02.1929</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Verfahren und Vorrichtung zum Ausl&auml;nden und Weiterbef&ouml;rdern von Langh&ouml;lzern aus Schwemmanlagen</span></font></p>
								</td>
								<td width=130 valign=top><p></p></td>
							</tr><tr><td height=24 width=105 valign=top><p><font size="-1"><span class="flie">114 660</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">02.08.1928</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">15.04.1929</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Ausl&auml;nde- und Sortieranlage f&uuml;r verschiedene auf Schwemmstra&szlig;en gebrachte H&ouml;lzer</span></font></p>
								</td>
								<td width=130 valign=top><p></p></td>
							</tr><tr><td height=36 width=105 valign=top><p><font size="-1"><span class="flie">118 713</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">12.08.1929</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">15.03.1930</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Auswurfvorrichtungen f&uuml;r Langholz u. dgl. aus Transportvorrichtungen, Riesen, Transportb&auml;ndern u. dgl.</span></font></p>
								</td>
								<td width=130 valign=top><p></p></td>
							</tr><tr><td height=25 width=105 valign=top><p><font size="-1"><span class="flie">122 144</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">11.12.1929</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">15.11.1930</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">K&uuml;nstliches Gerinne zum Schwemmen von Holz und dergleichen</span></font> </p>
								</td>
								<td width=130 valign=top><p><font size="-2"><span class="flieklein">Impl. Nr. 17</span></font></p></td>
							</tr><tr><td height=20 width=105 valign=top><p><font size="-1"><span class="flie">125 819</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">11.01.1930</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">15.07.1931</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Einrichtung zum Transport von Langh&ouml;lzern</span></font></p>
								</td>
								<td width=130 valign=top><p></p></td>
							</tr><tr><td height=47 width=105 valign=top><p><font size="-1"><span class="flie">136 214</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">23.04.1930</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">15.08.1933</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Anlage und Einrichtung zur Regelung des Abflussgerinnes von Staubecken und Festigkeitserh&ouml;hung deren Abschlussdammes </span></font></p>
								</td>
