							</tr><tr><td height=51 width=105 valign=top><p><font size="-1"><span class="flie">134 543</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">12.08.1931</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">15.04.1933</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Wasserf&uuml;hrung in Rohren und Gerinnen</span></font></p>
