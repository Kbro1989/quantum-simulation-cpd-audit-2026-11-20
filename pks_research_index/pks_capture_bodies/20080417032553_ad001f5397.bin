												CD-ROM &quot;DWdW&quot;</span></font></p>
								</td>
							</tr><tr><td height=59 width=105 valign=top><p><font size="-1"><span class="flie">138 296 </span></font></p><p><font size="-2"><span class="flieklein">auch:<br>DE 618 610,<br></span></font><font size="-2"><span class="flieklein">FR 763.215, </span></font><br><font size="-2"><span class="flieklein">GB 415.280</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">02.11.1932</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">15.03.1934</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Wasserf&uuml;hrung &shy; Zusatzpatent zu 134 543 (Doppeldrallrohr) </span></font></p>
								</td>
								<td width=130 valign=top><p><font size="-2"><span class="flieklein">Impl. Nr. 88</span></font><br>
										<font size="-2"><span class="flieklein">CD-ROM &quot;DWdW&quot;</span></font></p></td>
							</tr><tr><td height=60 width=105 valign=top><p><font size="-1"><span class="flie">142 032</span></font> </p><p><font size="-2"><span class="flieklein">auch:<br></span></font><font size="-2"><span class="flieklein">FR 785.965,<br></span></font><font size="-2"><span class="flieklein">HU 114.538</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">22.02.1934</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">15.01.1935</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Verfahren zur Herstellung von quellwasser-&auml;hnlichem Trinkwasser</span></font> </p>
								</td>
								<td width=130 valign=top><p><font size="-2"><span class="flieklein">Impl. Nr. 19 &quot;DWdW&quot;</span></font></p></td>
							</tr><tr><td height=24 width=105 valign=top><p><font size="-1"><span class="flie">143 069</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">13.11.1934</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">15.04.1935</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Verfahren zum Heben von Fl&uuml;ssigkeiten oder Gasen</span></font></p>
								</td>
								<td width=130 valign=top><p></p></td>
							</tr><tr><td height=20 width=105 valign=top><p><font size="-1"><span class="flie">145 141</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">07.03.1935</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">15.11.1935</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Luftturbine</span></font> </p>
								</td>
								<td width=130 valign=top><p><font size="-2"><span class="flieklein">Impl. Nr. 115</span></font></p></td>
							</tr><tr><td height=63 width=105 valign=top><p><font size="-1"><span class="flie">Sch 120 061</span></font> </p><p><font size="-2"><span class="flieklein">(Anm. D.R.P.A.)</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">04.03.1940</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">-</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Verfahren und Vorrichtung zur atomaren Umwandlung tropfbar fl&uuml;ssiger oder gasf&ouml;rmiger Stoffe</span></font> </p>
								</td>
								<td width=130 valign=top>
									<p><font size="-2"><span class="flieklein">Impl. Nr. 114</span></font></p>
								</td>
							</tr><tr><td height=65 width=105 valign=top><p><font size="-1"><span class="flie">Sch 122 278</span></font></p><p><font size="-2"><span class="flieklein">(Anm. D.R.P.A.)</span></font></p><p>&nbsp;</p></td><td width=105 valign=top><p><font size="-1"><span class="flie">31.03.1941</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">-</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Einrichtung zur Abspaltung einer energetischen Kernzone in str&ouml;menden Fl&uuml;ssigkeiten oder gasf&ouml;rmigen Stoffen</span></font></p>
								</td>
								<td width=130 valign=top><p></p></td>
							</tr><tr><td height=20 width=105 valign=top><p><font size="-1"><span class="flie">Anm. D.R.P.A.</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">18.12.1942</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">-</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Die Herzpumpe</span></font></p>
								</td>
								<td width=130 valign=top><p><font size="-2"><span class="flieklein">Impl. Nr. 130</span></font></p></td>
							</tr><tr><td height=36 width=105 valign=top><p><font size="-1"><span class="flie">Anm. D.R.P.A.</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">11.01.1943</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">-</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Der Repulsator &shy; Verfahren und Vorrichtung zur Durchf&uuml;hrung organischer Synthesen </span></font></p>
								</td>
								<td width=130 valign=top><p><font size="-2"><span class="flieklein">Impl. Nr. 131</span></font></p></td>
							</tr><tr><td height=60 width=105 valign=top><p><font size="-1"><span class="flie">Anm. D.R.P.A.</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">29.03.1943</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">-</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Die Repulsine: Verfahren und Vorrichtung zur Durchf&uuml;hrung von organischen Synthesen mit Hilfe kompressibel gestalteter, tropfbar fl&uuml;ssiger K&ouml;rper und Gasen in repulsiven Schwingungsformen</span></font></p>
								</td>
								<td width=130 valign=top><p></p></td>
							</tr><tr><td height=49 width=105 valign=top><p><font size="-1"><span class="flie">166 644</span></font></p><p><font size="-2"><span class="flieklein">auch:<br></span></font><font size="-2"><span class="flieklein">DE 809 725</span></font><font size="-2"><span class="style54">,</span></font><br><font size="-2"><span class="flieklein">CH 279 546</span></font></p></td><td width=105 valign=top><p><font size="-1"><span class="flie">17.02.1949 </span></font></p><p><font size="-2"><span class="flieklein">mit Dipl.-Ing. Franz Rosenberger</span></font></p></td>
								<td width=82 valign=top><p><font size="-1"><span class="flie">15.02.1950</span></font></p></td>
								<td width=234 valign=top>
									<p><font size="-1"><span class="flie">Bodenbearbeitungsger&auml;t &shy; (Verwendung von Kupfer bzw. Kupferlegierungen)</span></font></p>
								</td>
								<td width=130 valign=top><p></p></td>
